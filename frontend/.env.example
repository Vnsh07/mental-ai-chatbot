# Backend API URL (embedded at build time for production)
#
# Local dev (recommended): leave empty to use Vite proxy → http://127.0.0.1:8000
# VITE_API_URL=
#
# Local dev (direct): talk to FastAPI without proxy
# VITE_API_URL=http://127.0.0.1:8000
#
# Production (Render/Railway): your deployed API origin, no trailing slash
# VITE_API_URL=https://your-api.onrender.com

VITE_API_URL=
