# Local development (copy to .env)
DATABASE_URL=postgresql+psycopg2://mental:mental@localhost:5432/mental_ai
# SQLite alternative for quick local runs:
# DATABASE_URL=sqlite:///./mentalai.db

SECRET_KEY=dev-secret-change-me-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated frontend origins (no trailing slashes).
# Include every URL users open the app from (local + production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Allows all https://*.vercel.app origins (production + preview deployments).
# Set empty to disable: CORS_ORIGIN_REGEX=
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
