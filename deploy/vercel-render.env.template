# Copy values into Vercel (frontend) and Render (backend), then redeploy both.

# --- Vercel (Project → Settings → Environment Variables) ---
# Production + Preview + Development (for preview deploys):
VITE_API_URL=https://mental-ai-chatbot.onrender.com

# --- Render (mental-ai-api → Environment) ---
DATABASE_URL=<auto from Postgres or your value>
SECRET_KEY=<32+ random characters>
GEMINI_API_KEY=<Google AI Studio key>
GEMINI_MODEL=gemini-2.0-flash
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Exact Vercel URL(s) — replace with your real domain(s):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-PROJECT.vercel.app

# All Vercel apps (production + preview):
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
