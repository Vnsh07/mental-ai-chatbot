# Backend API (embedded at Vite build time)
#
# Local dev: leave empty to use Vite proxy → http://127.0.0.1:8000
VITE_API_URL=
#
# Production (Vercel): set in Vercel → Settings → Environment Variables
# VITE_API_URL=https://mental-ai-chatbot.onrender.com
#
# Or rely on vercel.json "env" + api.js DEFAULT_PRODUCTION_API for this project.
